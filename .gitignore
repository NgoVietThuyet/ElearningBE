# .gitignore for ASP.NET Core / .NET projects
# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# NuGet
*.nupkg
# NuGet Packages folder can be ignored if not using package restore
#packages/

# Rider
.idea/

# Others
*.swp
*.tmp
*.bak
*.old
*.orig

# Publish output
publish/

# Secrets
appsettings.*.json.local
